# Doubao / Volcengine ARK
DOUBAO_API_KEY=your_key_here
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_LLM_MODEL=doubao-1-5-pro-32k-250115
DOUBAO_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415

# Local SQLite (leave empty to use ./dev.db)
SQLITE_PATH=./dev.db

# Turso (production) — leave blank to use SQLite
# TURSO_URL=libsql://xxx.turso.io
# TURSO_TOKEN=xxx

# Set to "false" to skip downloading generated images (use remote URL with TTL)
PERSIST_IMAGES=true
